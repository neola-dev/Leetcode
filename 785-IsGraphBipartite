1class Solution {
2    public boolean isBipartite(int[][] graph) {
3        List<List<Integer>> adj=new ArrayList<>();
4        int n=graph.length;
5        for(int i=0;i<n;i++){
6            adj.add(new ArrayList<>());
7        }
8        for(int i=0;i<n;i++){
9            for(int j=0;j<graph[i].length;j++){
10                adj.get(i).add(graph[i][j]);
11            }
12        }
13        int[] colors=new int[n];
14        Arrays.fill(colors,-1);
15        for(int i=0;i<n;i++){
16            if(colors[i]==-1){
17                if(dfs(i,0,adj,colors)==false)   return false;
18            }
19        }
20        return true;
21    }
22    public boolean dfs(int node,int c,List<List<Integer>> adj,int[] colors){
23        colors[node]=c;
24        for(int nei:adj.get(node)){
25            if(colors[nei]==-1){
26                if(dfs(nei,1-c,adj,colors)==false)  return false;
27            }
28            if(colors[nei]==colors[node]) return false;
29        }
30        return true;
31    }
32}